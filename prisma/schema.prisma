// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Admin access and refresh tokens stay on Session. This row is the
// store snapshot plus the Storefront token the mobile app is allowed to see.
model ShopConfig {
  shop                    String    @id
  shopName                String
  currencyCode            String
  storefrontAccessToken   String?
  storefrontAccessTokenId String?
  storefrontScopes        String    @default("")
  metafieldDefinitions    Json
  metaobjectDefinitions   Json
  metaobjects             Json
  menus                   Json
  adminOnlyMetafields     Json
  truncated               Json
  warnings                Json
  syncError               String?
  syncedAt                DateTime?
  draftDesign             Json?
  publishedDesign         Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}
