# Local worker only. Copy to .env. Do not put production Supabase or Firebase values here.

NOTIFICATION_WORKER_ENV=local

# Must be a localhost database. The process refuses any other host.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/notifications_dev

# Local ElasticMQ only. Production enqueue uses OIDC and does not set this.
SQS_ENDPOINT=http://127.0.0.1:9324
SQS_QUEUE_NAME=notifications-jobs
AWS_REGION=ap-south-1

# FCM allows at most 500 messages per sendEach call. 1–500.
NOTIFICATION_BATCH_SIZE=500

# Optional local file for a dry run. Merchant credentials belong in Postgres, not in this file.
FIREBASE_SECRET_SOURCE=file
FIREBASE_SERVICE_ACCOUNT_PATH=./.secrets/firebase-test.json
