# Supabase pooled connection (port 6543). Prisma uses this at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase session connection (port 5432). Prisma uses this for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Shopify app credentials. Set the same values in the Vercel project.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SCOPES="read_products,read_content,read_online_store_navigation,read_metaobjects,read_metaobject_definitions,read_orders,read_fulfillments,unauthenticated_read_product_listings,unauthenticated_read_product_inventory,unauthenticated_write_checkouts,unauthenticated_read_checkouts,unauthenticated_read_content,unauthenticated_read_metaobjects"
SHOPIFY_APP_URL="https://shopify-mobile-app-tau.vercel.app"

# HMAC secret for short-lived X-Mobile-Session tokens (generate a long random string).
MOBILE_SESSION_SECRET=""

# Optional: guest order access email (Resend).
# Domain: tryclevercat.com must be verified in Resend → Domains.
RESEND_API_KEY=""
ORDER_ACCESS_FROM_EMAIL="orders@tryclevercat.com"
GUEST_ORDER_DEEP_LINK_BASE="myapp://orders/guest"
