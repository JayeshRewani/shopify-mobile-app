# Local worker only. Copy to .env for ElasticMQ + local Postgres.
# For DigitalOcean production, copy to the droplet env / .env.do and set NOTIFICATION_WORKER_ENV=do.

NOTIFICATION_WORKER_ENV=local

# Must be a localhost database for local. On DigitalOcean use the production pooler URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/notifications_dev

# Local ElasticMQ only. Must be UNSET on DigitalOcean.
SQS_ENDPOINT=http://127.0.0.1:9324
SQS_QUEUE_NAME=notifications-jobs
AWS_REGION=ap-south-1

# FCM allows at most 500 messages per sendEach call. 1–500.
NOTIFICATION_BATCH_SIZE=500

# Optional local file for a dry run. Merchant credentials belong in Postgres, not in this file.
FIREBASE_SECRET_SOURCE=file
FIREBASE_SERVICE_ACCOUNT_PATH=./.secrets/firebase-test.json

# --- DigitalOcean worker (NOTIFICATION_WORKER_ENV=do) ---
# NOTIFICATION_WORKER_ENV=do
# DATABASE_URL=postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true&connection_limit=1
# NOTIFICATIONS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/874287870446/mobile-app-notifications-jobs
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# PROMOTE_INTERVAL_MS=60000
# SQS_WAIT_TIME_SECONDS=20
# SQS_VISIBILITY_TIMEOUT=180
# Do not set SQS_ENDPOINT on DigitalOcean.
